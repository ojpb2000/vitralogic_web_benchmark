# Copia este archivo a ".env" en la raíz del proyecto y rellena los valores.
# Nunca subas .env al repositorio (ya está en .gitignore).

# --- Visión con Gemini (recomendado; clave en Google AI Studio) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternativa: algunos tutoriales usan este nombre (si defines solo uno, basta)
# GOOGLE_API_KEY=

# Proveedor de visión al usar: python scripts/build_social_benchmark.py --vision
# Valores: gemini | openai
VISION_PROVIDER=gemini

# Modelo (opcional). Vacío en .env = se usa el default del script (gemini-2.0-flash u openai gpt-4o-mini).
# VISION_MODEL=gemini-2.0-flash

# --- Clasificación con taxonomía cerrada (Gemini, texto + imagen) ---
# GEMINI_CLASSIFY_MODE=multimodal
# doubtful | multimodal | all
# GEMINI_MIN_CONFIDENCE=0.72

# --- Solo si usas --vision-provider openai ---
# OPENAI_API_KEY=
